{
  "name": "hugo-academic-theme",
  "description": "A clean, modern Hugo theme for academic and professional personal websites",
  "version": "1.0.0",
  "repository": "https://github.com/mvictoras/www.git",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "hugo new",
    "prestart": "npm run clean",
    "start": "hugo server --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost",
    "prebuild": "npm run clean",
    "build": "hugo --gc --minify",
    "build:lan": "hugo --gc --minify --baseURL=http://192.168.1.10:8080",
    "build:preview": "npm run build -D -F",
    "clean": "shx rm -rf public resources",
    "clean:install": "shx rm -rf package-lock.json node_modules",
    "lint": "npm run -s lint:scripts && npm run -s lint:styles && npm run -s lint:markdown",
    "lint:scripts": "eslint themes/academic/assets/js config",
    "lint:styles": "stylelint \"themes/academic/assets/scss/**/*.{css,sass,scss,sss,less}\"",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "lint:markdown-fix": "markdownlint-cli2-fix \"*.md\" \"content/**/*.md\"",
    "server": "hugo server",
    "test": "npm run -s lint",
    "env": "env",
    "check": "hugo version",
    "latest:hugo": "gh release view --repo gohugoio/hugo",
    "latest:www": "gh release view --repo mvictoras/www",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "academicons": "1.9.5",
    "autoprefixer": "10.5.0",
    "bootstrap": "5.3.8",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "gsap": "3.15.0",
    "lazysizes": "^5.3.2",
    "markdownlint-cli2": "0.22.1",
    "photoswipe": "^5.4.4",
    "postcss-cli": "^11.0.0",
    "prismjs": "^1.27.0",
    "shx": "0.4.0",
    "stylelint": "17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "7.2.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "dayjs": "1.11.21",
    "quicklink": "^2.3.0"
  }
}
