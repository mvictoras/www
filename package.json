{
  "name": "hugo-academic-theme",
  "description": "A clean, modern Hugo theme for academic and professional personal websites",
  "version": "1.0.0",
  "repository": "https://github.com/mvictoras/www.git",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "exec-bin node_modules/.bin/hugo/hugo new",
    "prestart": "npm run clean",
    "start": "exec-bin node_modules/.bin/hugo/hugo server  --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost",
    "prebuild": "npm run clean",
    "build": "exec-bin node_modules/.bin/hugo/hugo --gc --minify",
    "build:lan": "exec-bin node_modules/.bin/hugo/hugo --gc --minify --baseURL=http://192.168.1.10:8080",
    "build:preview": "npm run build -D -F",
    "clean": "shx rm -rf public resources",
    "clean:install": "shx rm -rf package-lock.json node_modules ",
    "lint": "npm run -s lint:scripts && npm run -s lint:styles && npm run -s lint:markdown",
    "lint:scripts": "eslint themes/academic/assets/js config",
    "lint:styles": "stylelint \"themes/academic/assets/scss/**/*.{css,sass,scss,sss,less}\"",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "lint:markdown-fix": "markdownlint-cli2-fix \"*.md\" \"content/**/*.md\"",
    "server": "exec-bin node_modules/.bin/hugo/hugo server",
    "test": "npm run -s lint",
    "env": "env",
    "precheck": "npm version",
    "check": "exec-bin node_modules/.bin/hugo/hugo version",
    "latest:hugo": "gh release view --repo gohugoio/hugo",
    "latest:www": "gh release view --repo mvictoras/www",
    "postinstall": "hugo-installer --version otherDependencies.hugo --extended --destination node_modules/.bin/hugo",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@babel/cli": "^7.17",
    "@babel/core": "^7.17",
    "@babel/preset-env": "^7.16",
    "@fortawesome/fontawesome-free": "^6.7.1",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "academicons": "^1.8.6",
    "autoprefixer": "^10.4",
    "bootstrap": "^5.3.3",
    "eslint": "^9.0.0",
    "exec-bin": "^1.0.0",
    "globals": "^15.15.0",
    "gsap": "^3.14.2",
    "hugo-installer": "^4.0.1",
    "lazysizes": "^5.3.2",
    "markdownlint-cli2": "^0.18.0",
    "photoswipe": "^5.4.4",
    "postcss-cli": "^11.0.0",
    "prismjs": "^1.27.0",
    "rimraf": "^3.0",
    "shx": "^0.3",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0"
  },
  "otherDependencies": {
    "hugo": "0.131.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "dayjs": "^1.11.19",
    "quicklink": "^2.3.0"
  }
}
